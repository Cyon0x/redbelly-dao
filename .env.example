# WalletConnect Cloud project id (https://cloud.reown.com). Optional but recommended.
# Without it, MetaMask / injected wallets still work; the WalletConnect option is hidden.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public site URL, used for SEO metadata + sitemap. Set to your Vercel domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
